# BTC Cycle Radar - Environment Configuration (Phase 1+)
# Copy to .env dan isi nilai-nilai yang dibutuhkan.

# === Server ===
BIND_ADDR=0.0.0.0:8099
# DATABASE_URL format SQLite: sqlite://data/btc_cycle_radar.db  (relative to binary)
# Atau in-memory untuk test: sqlite::memory:
DATABASE_URL=sqlite://data/btc_cycle_radar.db
# Direktori build frontend (Phase 4). Kosongkan kalau belum ada.
STATIC_DIR=static

# === Data Sources ===
# CoinMetrics Community API (no API key required for PriceUSD daily)
COINMETRICS_BASE_URL=https://community-api.coinmetrics.io/v4
# Binance base URLs (failover order). data-api.binance.vision is regional-friendly mirror.
BINANCE_BASE_URLS=https://data-api.binance.vision,https://api.binance.com

# Bootstrap control
BOOTSTRAP_START=2010-07-01
MIN_REQUIRED_CANDLES=4500
# AUTO_BOOTSTRAP=false untuk disable bootstrap otomatis saat startup
AUTO_BOOTSTRAP=true

# === Phase 2 (optional API keys) ===
# BGeometrics free tier: 15 req/hari, 10 req/jam
# BGEOMETRICS_API_KEY=your_key_here
# BGEOMETRICS_MAX_ENDPOINTS_PER_DAY=8

# FRED API (untuk T10Y2Y, WALCL)
# FRED_API_KEY=your_key_here

# === Logging ===
RUST_LOG=btc_cycle_radar=debug,sqlx=warn,axum=info,tower_http=info