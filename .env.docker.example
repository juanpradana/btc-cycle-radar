# ---------------------------------------------------------------------------
# BTC Cycle Radar — contoh konfigurasi untuk Docker Compose.
#
# Pakai:
#   cp .env.docker.example .env
#   docker compose up -d --build
#
# Berkas .env dibaca otomatis oleh `docker compose` (untuk substitusi variabel)
# dan sudah di-ignore oleh git: JANGAN commit berkas .env yang berisi key asli.
# Semua baris di bawah opsional — tanpa satu pun terisi, sistem tetap berjalan
# penuh untuk indikator berbasis OHLCV + CoinMetrics Community.
# ---------------------------------------------------------------------------

# === Server ===
# Port di host yang dipetakan ke container (container tetap 8099).
HOST_PORT=8099
TZ=UTC
# RUST_LOG=btc_cycle_radar=info,sqlx=warn,axum=info,tower_http=info

# === Bootstrap & verifikasi data ===
BOOTSTRAP_START=2010-07-01
# Minimal candle daily riil yang harus ada (verifikasi fase 1).
MIN_REQUIRED_CANDLES=4500
# true = unduh riwayat otomatis saat container pertama kali start.
AUTO_BOOTSTRAP=true

# === API key opsional (Phase 2) ===
# BGeometrics free tier: 15 req/hari, 10 req/jam, delay data ~7 hari.
# BGEOMETRICS_API_KEY=
BGEOMETRICS_MAX_ENDPOINTS_PER_DAY=8
# FRED (untuk T10Y2Y, WALCL).
# FRED_API_KEY=

# === Sinkronisasi harian (profil "cron") ===
# Jarak antar sinkronisasi dalam detik (default 24 jam).
SYNC_INTERVAL_SECONDS=86400
